{
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "functions": [
        {
            "runtime": "nodejs20",
            "source": "functions/usuarios",
            "codebase": "usuarios",
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-debug.*.log"
            ]
        },
        {
            "runtime": "nodejs20",
            "source": "functions/ofertas",
            "codebase": "ofertas",
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-debug.*.log"
            ]
        },
        {
            "runtime": "nodejs20",
            "source": "functions/matching",
            "codebase": "matching",
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-debug.*.log"
            ]
        }
    ],
    "hosting": {
        "public": "web/dist",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "/api/users",
                "function": "usuarios"
            },
            {
                "source": "/api/users/**",
                "function": "usuarios"
            },
            {
                "source": "/api/auth",
                "function": "usuarios"
            },
            {
                "source": "/api/auth/**",
                "function": "usuarios"
            },
            {
                "source": "/api/offers",
                "function": "ofertas"
            },
            {
                "source": "/api/offers/**",
                "function": "ofertas"
            },
            {
                "source": "/api/matching",
                "function": "matching"
            },
            {
                "source": "/api/matching/**",
                "function": "matching"
            },
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    }
}